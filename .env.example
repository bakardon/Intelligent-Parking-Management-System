# ParkSight configuration. Copy to .env and fill in the values.
# Never commit .env: it contains passwords.

# --- PostgreSQL ---------------------------------------------------------------
# Docker Compose: DB_HOST is set to "db" automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parksight
DB_USER=parksight
# Generate e.g. with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=change-me

# --- Security -----------------------------------------------------------------
# Encrypts stored camera passwords. Generate once and keep it with your
# backups: if it is lost, camera passwords must be re-entered.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PARKSIGHT_SECRET_KEY=
# Set to true when ParkSight is served over HTTPS (reverse proxy).
PARKSIGHT_COOKIE_SECURE=false
PARKSIGHT_SESSION_HOURS=12

# --- Site ---------------------------------------------------------------------
PARKSIGHT_TIMEZONE=Asia/Karachi
PARKSIGHT_PORT=8000

# --- Inference (CPU) ----------------------------------------------------------
# Local (non-Docker) model path; Docker uses ./models/yolo11n.pt.
PARKSIGHT_MODEL_PATH=yolo11n.pt
PARKSIGHT_DEVICE=cpu
PARKSIGHT_TORCH_THREADS=1
PARKSIGHT_IMAGE_SIZE=640
PARKSIGHT_LOG_LEVEL=INFO
